# General API (Android emulator → host machine)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Public web URL for meeting invite links (/join/…). Must be openable in a PC browser.
# Same value as NEXT_PUBLIC_APP_URL or NEXTAUTH_URL on the web app.
# Option A (same Mac): http://localhost:3000
# Option B (other PCs on your Wi‑Fi): http://192.168.1.100:3000
# Production: https://your-domain.com
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# OAuth browser flow — MUST NOT use 10.0.2.2 (Google blocks it).
# Option A (emulator): localhost + adb reverse (auto-used when API URL is 10.0.2.2)
# EXPO_PUBLIC_OAUTH_API_URL=http://localhost:3000
#
# Option B: your Mac LAN IP (same value as NEXTAUTH_URL on the web app)
# EXPO_PUBLIC_OAUTH_API_URL=http://192.168.1.100:3000

# Optional: fallback LiveKit URL
# EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
