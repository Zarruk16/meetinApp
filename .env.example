# General API (Android emulator → 10.0.2.2). Physical iPhone auto-uses EXPO_PUBLIC_OAUTH_API_URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Public web URL for meeting invite links (/join/…). Must be openable in a PC browser.
# Same value as NEXT_PUBLIC_APP_URL or NEXTAUTH_URL on the web app.
# Option A (same Mac): http://localhost:3000
# Option B (other PCs on your Wi‑Fi): http://192.168.1.100:3000
# Production: https://your-domain.com
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# OAuth browser (Google/GitHub). Emulator cannot use localhost without adb reverse.
# Easiest: use production auth while API stays local:
EXPO_PUBLIC_OAUTH_API_URL=https://blumen-meet.vercel.app
#
# Local OAuth instead: EXPO_PUBLIC_OAUTH_API_URL=http://localhost:3000
# then run: npm run adb:reverse
# (with blumen_meet on npm run dev and NEXTAUTH_URL=http://localhost:3000)

# Optional: fallback LiveKit URL
# EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
